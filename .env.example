# N.E.K.O. needs NO secrets in local-only mode. This file only documents the
# environment variables it understands. Never put real secrets in this file.

# Override the Ollama address (must be this computer or a private LAN address)
# NEKO_OLLAMA_URL=http://127.0.0.1:11434

# Put N.E.K.O.'s data (database, logs, backups) somewhere else
# NEKO_DATA_DIR=D:\NEKO-data

# Use a different config file
# NEKO_CONFIG=D:\NEKO-data\config.toml

# Token for an OPTIONAL paired desktop (name chosen in [[remote.endpoints]].token_env).
# Set it in your user environment, not in a file:  setx NEKO_REMOTE_DESKTOP_TOKEN "<long random value>"
# NEKO_REMOTE_DESKTOP_TOKEN=
